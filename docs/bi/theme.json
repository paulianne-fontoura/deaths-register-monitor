{
  "name": "deaths-register-monitor",
  "dataColors": [
    "#2A6FDB",
    "#74A3F3",
    "#1F4FA8",
    "#9DBDF7",
    "#6D5AE6",
    "#4C86E8",
    "#B9CEF9",
    "#52514E"
  ],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A6FDB",
  "good": "#008300",
  "neutral": "#EDA100",
  "bad": "#B60205",
  "textClasses": {
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    },
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 25
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5B79B0"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 80
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EDF2FC"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
